# Google Maps Platform: abilitare Maps JavaScript API, Places API (New), Routes API
VITE_GOOGLE_MAPS_KEY=
# Opzionale: Map ID creato in Google Cloud (altrimenti DEMO_MAP_ID)
VITE_GOOGLE_MAP_ID=
# Opzionale: chiave gratuita TomTom (developer.tomtom.com) per cantieri e incidenti in tempo reale
VITE_TOMTOM_KEY=
